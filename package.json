{
  "name": "oracle-speakflow",
  "version": "0.1.0",
  "description": "Speech-to-paste daemon: hotkey → Groq Whisper → inject text at cursor",
  "type": "module",
  "main": "dist/electron-main.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "build:ui": "vite build",
    "start:app": "npm run build && npm run build:ui && electron dist/electron-main.js",
    "start:electron": "electron dist/electron-main.js",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:focus": "node scripts/check-focus-grep.mjs",
    "check:workflows": "node scripts/check-workflows.mjs",
    "test": "vitest run --config vitest.config.ts",
    "test:ui": "vitest run --config vitest.ui.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "test:integration": "npm run build && npm run build:ui && playwright test",
    "package": "npm run build && npm run build:ui && electron-builder"
  },
  "dependencies": {
    "@nut-tree-fork/nut-js": "^4.2.6",
    "groq-sdk": "^0.7.0",
    "node-record-lpcm16": "^1.0.1",
    "onnxruntime-node": "^1.20.1",
    "uiohook-napi": "^1.5.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@sveltejs/vite-plugin-svelte": "^3.1.2",
    "@tailwindcss/vite": "^4.3.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/svelte": "^5.3.1",
    "@types/node": "^20.0.0",
    "clsx": "^2.1.1",
    "electron": "^41.3.0",
    "electron-builder": "^26.8.1",
    "jsdom": "^29.1.0",
    "playwright": "^1.59.1",
    "svelte": "^4.2.20",
    "svelte-preprocess": "^6.0.3",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.7.0",
    "typescript": "^5.4.0",
    "vite": "^5.4.21",
    "vitest": "^1.5.0"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "build": {
    "appId": "com.oracle-speakflow.app",
    "productName": "Oracle SpeakFlow",
    "directories": {
      "output": "dist-installer"
    },
    "npmRebuild": false,
    "files": [
      "dist/**/*",
      "dist-ui/**/*",
      "package.json",
      "!**/*.map"
    ],
    "asarUnpack": [
      "node_modules/clipboardy/fallbacks/**",
      "node_modules/@nut-tree-fork/libnut-win32/build/Release/**",
      "node_modules/uiohook-napi/prebuilds/**",
      "node_modules/onnxruntime-node/bin/**"
    ],
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "identity": null,
      "target": [
        { "target": "dmg" },
        { "target": "zip" }
      ],
      "category": "public.app-category.productivity",
      "artifactName": "${productName}-${version}-${arch}.${ext}"
    }
  }
}
