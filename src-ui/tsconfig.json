{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["vite/client"],
    "paths": {
      "$lib": ["./lib"],
      "$lib/*": ["./lib/*"]
    }
  },
  "include": ["./**/*", "../src/types/ipc.ts"]
}
